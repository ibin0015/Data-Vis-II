          }
        },
        "xOffset": { "field": "jitter", "type": "quantitative" },
        "x": {
          "field": "state", "type": "ordinal",
          "sort": ["NSW","VIC","ACT","QLD","WA","SA","TAS","NT"],
          "axis": {
            "title": null, "labelFontSize": 12, "labelFontWeight": "bold",
