            "symbolSize": 80, "offset": 8, "labelFontSize": 10
          }
        },
        "tooltip": [
          { "field": "city",  "title": "City" },
          { "field": "state", "title": "State" },
          { "field": "price", "title": "Avg Price", "format": "$,.2f" },
          { "field": "cafes", "title": "Cafés",     "format": "," }
        ]
      }
    },
    {
      "transform": [
        { "filter": "indexof(['Sydney','Melbourne','Darwin','Adelaide','Canberra','Perth','Brisbane','Hobart'], datum.city) >= 0" }
