{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 300,
  "title": {
    "text": "Preferred Coffee Bean Types by Domestic Consumption"
  },
  "data": {
    "url": "Data/Coffee_domestic_consumption.csv"
  },
  "transform": [
    {
      "calculate": "indexof(datum['Coffee type'], 'Arabica') >= 0 ? datum['Total_domestic_consumption'] : 0",
      "as": "arabica_val"
    },
    {
      "calculate": "indexof(datum['Coffee type'], 'Robusta') >= 0 ? datum['Total_domestic_consumption'] : 0",
      "as": "robusta_val"
    },
    {
      "fold": ["arabica_val", "robusta_val"],
      "as": ["bean_type", "consumption"]
    },
    { "filter": "datum.consumption > 0" },
    {
      "calculate": "datum.bean_type === 'arabica_val' ? 'Arabica' : 'Robusta'",
      "as": "Coffee Type"
    },
    {
      "aggregate": [{ "op": "sum", "field": "consumption", "as": "total_consumption" }],
      "groupby": ["Coffee Type"]
    },
    {
      "joinaggregate": [{ "op": "sum", "field": "total_consumption", "as": "grand_total" }]
    },
    { "calculate": "datum.total_consumption / datum.grand_total", "as": "percentage" },
    { "calculate": "datum.total_consumption / 1000000", "as": "consumption_millions" },
    { "calculate": "datum.grand_total / 1000000", "as": "grand_total_millions" }
  ],
  "layer": [
    {
      "mark": { "type": "rule", "color": "#C4A882", "strokeWidth": 2 },
      "encoding": {
        "y": {
          "field": "Coffee Type",
          "type": "nominal",
          "sort": { "field": "consumption_millions", "order": "descending" },
          "title": "Coffee Type"
        },
        "x": { "field": "consumption_millions", "type": "quantitative" },
        "x2": { "value": 0 }
      }
    },
    {
      "mark": { "type": "point", "filled": true, "size": 120 },
      "encoding": {
        "y": {
          "field": "Coffee Type",
          "type": "nominal",
          "sort": { "field": "consumption_millions", "order": "descending" },
          "title": "Coffee Type",
          "axis": { "labelFontSize": 12, "titleFontSize": 13 }
        },
        "x": {
          "field": "consumption_millions",
          "type": "quantitative",
          "title": "Total Domestic Consumption (millions of 60kg bags)",
          "axis": { "format": ",.0f", "titleFontSize": 13 }
        },
        "color": {
          "field": "Coffee Type",
          "type": "nominal",
          "scale": {
            "domain": ["Arabica", "Robusta"],
            "range": ["#3B1005", "#8B5A2B"]
          },
          "legend": null
        },
        "tooltip": [
          { "field": "Coffee Type", "title": "Coffee Type" },
          { "field": "consumption_millions", "title": "Total Consumption (M bags)", "format": ",.1f" },
          { "field": "percentage", "title": "Share", "format": ".1%" }
        ]
      }
    }
  ],
  "config": {
    "background": "#FDF6EE",
    "view": { "stroke": "transparent" }
  }
}